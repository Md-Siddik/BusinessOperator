# ─────────────────────────────────────────────────────────────
# ExploreTechify — environment configuration
# Copy to .env.local for development. Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# Database. Leave empty in development to use the built-in local
# MongoDB (mongodb-memory-server, data stored in .data/mongo).
# REQUIRED in production.
MONGODB_URI=

# Session signing secret (32+ random characters). REQUIRED in production.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Public site URL (canonical URLs, hreflang, sitemap, emails). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_DOMAIN=exploretechify.com
NEXT_PUBLIC_CONTACT_EMAIL=hello@exploretechify.com

# ── Data mode ────────────────────────────────────────────────
# Company intelligence uses REAL registry data. With REAL_DATA_MODE=true,
# demo providers can never be enabled. DEMO_MODE=true (development only)
# enables fictional, clearly-labelled demo companies; it is ignored in
# production unless ALLOW_DEMO_IN_PRODUCTION=true is set by the Owner.
REAL_DATA_MODE=true
DEMO_MODE=false
ALLOW_DEMO_IN_PRODUCTION=false

# Development accounts: on an empty database, create owner/admin/staff/client
# logins (sharing DEMO_PASSWORD) and a sample client workspace. Never in production.
SEED_DEV_ACCOUNTS=true
DEMO_PASSWORD=
DEMO_OWNER_EMAIL=owner@demo.exploretechify.local
DEMO_ADMIN_EMAIL=admin@demo.exploretechify.local
DEMO_STAFF_EMAIL=staff@demo.exploretechify.local
DEMO_CLIENT_EMAIL=client@demo.exploretechify.local

# Email provider: console (default, logs only) | resend | sendgrid
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM=hello@exploretechify.com

# ── Company registry providers (server-side only; see docs/providers/) ──
# Norway — Brønnøysundregistrene: public API, no key. URL override optional.
BRREG_API_URL=
# Finland — PRH YTJ open data v3: public API, no key. URL override optional.
FINLAND_PRH_API_URL=
# United Kingdom — Companies House Public Data API (free key):
#   https://developer.company-information.service.gov.uk/
UK_COMPANIES_HOUSE_API_KEY=
# France — INSEE API Sirene 3.11 (free key): https://portail-api.insee.fr/
FRANCE_SIRENE_API_KEY=
FRANCE_SIRENE_API_URL=
# Include sole traders (natural persons) from Sirene. Default false (privacy).
FRANCE_INCLUDE_SOLE_TRADERS=false
# Denmark — CVR system-to-system access (credentials from cvrselvbetjening@erst.dk)
DENMARK_CVR_USERNAME=
DENMARK_CVR_PASSWORD=
DENMARK_CVR_API_URL=
# United Kingdom — separate STREAMING application key (stream.companieshouse.gov.uk)
UK_COMPANIES_HOUSE_STREAMING_API_KEY=
UK_STREAM_WORKER=on
# Netherlands — KVK API subscription (Mutatieservice + Basisprofiel), header "apikey".
# NL_KVK_API_URL defaults to production; KVK's test environment (fictional data) is refused in production.
NL_KVK_API_KEY=
NL_KVK_SUBSCRIPTION_ID=
NL_KVK_API_URL=
# Estonia — RIK e-Business Register XML services (agreement + username/password)
ESTONIA_RIK_USERNAME=
ESTONIA_RIK_PASSWORD=
ESTONIA_RIK_API_URL=
# Germany — OpenRegister (commercial, Bearer key)
OPENREGISTER_API_KEY=
# Ireland — CRO open data (no key). Overrides are optional.
IRELAND_CRO_API_URL=
IRELAND_CRO_RESOURCE_ID=
# Commercial fallback for gaps (enable per country in Settings → Countries)
OPENCORPORATES_API_TOKEN=
# Sweden: SCB Business Register API needs a client certificate from SCB — no adapter yet (see docs).

# ── Contact-data providers (retrieval only — no sending, sequences or campaigns) ──
# Enable each in Settings → Research and set budgets there (budget 0 = paid calls paused).
HUNTER_API_KEY=
APOLLO_API_KEY=
BRAVE_SEARCH_API_KEY=
# A value shared by this many companies is treated as an intermediary
SHARED_CONTACT_THRESHOLD=3

# Sync engine
REGISTRY_MAX_PER_RUN=5000
REGISTRY_PEOPLE_PER_RUN=300
# In-process workers (single instance). Set to "off" on serverless/multi-instance
# deployments and call /api/registry/cron (every 5 min) and /api/jobs/cron (every 30–60 s).
REGISTRY_SCHEDULER=on
WORKER_FAST_TICK_MS=30000
RESEARCH_CONCURRENCY=2
# Live feed polling (seconds) — subject to each source's limits
NORWAY_FEED_POLL_SECONDS=60
NL_FEED_POLL_SECONDS=60
ESTONIA_FEED_POLL_SECONDS=300
# Protects /api/registry/cron (scheduled syncs + follow-up reminders).
CRON_SECRET=


# ── Verified Opportunity Intelligence (OWNER-only module; see docs/opportunities/README.md) ──
# Open sources need no keys: TED, Arbetsförmedlingen JobTech (SE), Find a Tender, Contracts Finder,
# BOAMP, and employer Greenhouse / Lever / Ashby boards and careers pages.
# Feeds run on the existing slow tick; set OPPORTUNITY_SCHEDULER=off to pause them.
OPPORTUNITY_SCHEDULER=on
# Max records processed per feed run (capped runs resume from their cursor on the next tick).
OPPORTUNITY_RUN_LIMIT=1500
# Norway — NAV job vacancy feed: free consumer token on request (nav.team.arbeidsplassen@nav.no).
NAV_JOB_FEED_TOKEN=
NAV_JOB_FEED_URL=
# France — France Travail Offres d'emploi v2: register an application on francetravail.io.
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
# Adzuna (aggregator; UK/DE/FR). Commercial use needs an Adzuna agreement — also enable it in the UI.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Realtime: memory (single instance). Implement a Redis provider to scale out.
REALTIME_PROVIDER=memory

# File uploads (chat attachments, ticket attachments, documents).
UPLOAD_DIR=storage/uploads
