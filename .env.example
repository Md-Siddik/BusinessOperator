# ─────────────────────────────────────────────────────────────
# ExploreTechify — environment configuration
# Copy to .env.local for development. Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# Database. Leave empty in development to use the built-in local
# MongoDB (mongodb-memory-server, data stored in .data/mongo).
# REQUIRED in production.
MONGODB_URI=

# Session signing secret (32+ random characters). REQUIRED in production.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
# Optional: separate key for hashing anonymous analytics visitor ids (defaults to AUTH_SECRET).
# Changing it makes every existing visitor look new. See docs/website-analytics.md.
ANALYTICS_SECRET=
# Optional: GeoIP database for visitor locations (default .data/geoip/dbip-city-lite.mmdb).
# Download/refresh monthly with `npm run geoip:update`. IP addresses are never stored.
GEOIP_DB_PATH=

# Public site URL (canonical URLs, hreflang, sitemap, emails). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_DOMAIN=exploretechify.com
NEXT_PUBLIC_CONTACT_EMAIL=hello@exploretechify.com

# ── Data mode ────────────────────────────────────────────────
# Company intelligence uses REAL registry data. With REAL_DATA_MODE=true,
# demo providers can never be enabled. DEMO_MODE=true (development only)
# enables fictional, clearly-labelled demo companies; it is ignored in
# production unless ALLOW_DEMO_IN_PRODUCTION=true is set by the Owner.
REAL_DATA_MODE=true
DEMO_MODE=false
ALLOW_DEMO_IN_PRODUCTION=false

# Development accounts: on an empty database, create owner/admin/staff/client
# logins (sharing DEMO_PASSWORD) and a sample client workspace. Never in production.
SEED_DEV_ACCOUNTS=true
DEMO_PASSWORD=
DEMO_OWNER_EMAIL=owner@demo.exploretechify.local
DEMO_ADMIN_EMAIL=admin@demo.exploretechify.local
DEMO_STAFF_EMAIL=staff@demo.exploretechify.local
DEMO_CLIENT_EMAIL=client@demo.exploretechify.local

# Email provider: console (default, logs only) | resend | sendgrid | zoho-smtp
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM=hello@exploretechify.com
# Provider request / SMTP timeout (ms). A timeout is reported as "outcome unknown", never as sent.
EMAIL_SEND_TIMEOUT_MS=20000

# ── Zoho Mail SMTP (EMAIL_PROVIDER=zoho-smtp; see docs/email-sender.md) ──
# Server-side only — never prefix these with NEXT_PUBLIC_. Copy the host from
# Zoho Mail → Settings → Mail Accounts → (your address) → SMTP for YOUR account's data
# centre and account type (e.g. smtp.zoho.com / smtp.zoho.eu / smtp.zoho.in, or
# smtppro.zoho.* for organization mailboxes). Do not guess it.
ZOHO_SMTP_HOST=
# 465 with SECURE=true (SSL)  or  587 with SECURE=false (STARTTLS, required)
ZOHO_SMTP_PORT=465
ZOHO_SMTP_SECURE=true
# Full Zoho mailbox address you sign in with
ZOHO_SMTP_USER=
# Zoho account password, or an application-specific password if 2FA is on (recommended)
ZOHO_SMTP_PASSWORD=
# From address: the mailbox above or one of its Zoho aliases (Zoho refuses anything else).
# With zoho-smtp this replaces EMAIL_SENDER_FROM / EMAIL_FROM for every email the site sends.
EMAIL_FROM_ADDRESS=
# Shown as the sender and used as the signature. A real person's name reads most naturally
# (e.g. "Jane Doe" or "Jane Doe | ExploreTechify"); keep it the same on every email.
EMAIL_FROM_NAME=ExploreTechify Team
# Optional: where replies go. Default with zoho-smtp = EMAIL_FROM_ADDRESS. Must be monitored.
EMAIL_REPLY_TO=

# ── Client Mail (Owner-only, /dashboard/mailbox) — reads the Zoho inbox over IMAP ──
# Enable IMAP in Zoho Mail → Settings → Mail Accounts → IMAP Access. Uses ZOHO_SMTP_USER /
# ZOHO_SMTP_PASSWORD; override only if they differ. Host default: ZOHO_SMTP_HOST with smtp→imap.
ZOHO_IMAP_HOST=
ZOHO_IMAP_PORT=993
ZOHO_IMAP_USER=
ZOHO_IMAP_PASSWORD=
# New-email notification check interval (ms, worker fast tick). MAILBOX_POLL=off disables it.
MAILBOX_POLL_MS=60000

# ── Email Sender (Owner-only, /dashboard/email-sender; see docs/email-sender.md) ──
# Needs a live provider above (zoho-smtp, or resend/sendgrid + EMAIL_API_KEY) and a public
# https NEXT_PUBLIC_SITE_URL (the unsubscribe link). Without them the page shows a setup error.
# From address for resend/sendgrid — must be a sender verified with the provider.
EMAIL_SENDER_FROM=hello@exploretechify.com
EMAIL_SENDER_FROM_NAME=ExploreTechify Team
# Optional: business postal address printed above the opt-out line (required for commercial
# email in some jurisdictions, e.g. CAN-SPAM in the US). Leave empty to omit.
EMAIL_SENDER_POSTAL_ADDRESS=
# Abuse / duplicate protection
EMAIL_SENDER_HOURLY_LIMIT=20
EMAIL_SENDER_DAILY_LIMIT=50
# Minutes before the same address can be emailed again (0 = off)
EMAIL_SENDER_COOLDOWN_MINUTES=60
# Days to keep Email Sender history records (bodies are never stored)
EMAIL_SENDER_RETENTION_DAYS=365
# The single polite reminder may be sent this many days after the first email (at most one per company).
EMAIL_SENDER_REMINDER_MIN_DAYS=7

# ── Company registry providers (server-side only; see docs/providers/) ──
# Norway — Brønnøysundregistrene: public API, no key. URL override optional.
BRREG_API_URL=
# Finland — PRH YTJ open data v3: public API, no key. URL override optional.
FINLAND_PRH_API_URL=
# Latvia — UR open data register.csv on data.gov.lv (CC0, daily): no key. URL overrides optional.
LATVIA_UR_REGISTER_URL=
LATVIA_UR_DATASET_API=
# Estonia — RIK open data "Basic data" ZIP (CC BY 4.0, daily): no key. URL override optional.
ESTONIA_RIK_OPEN_DATA_URL=
# Include sole traders (FIE, natural persons). Default false (privacy).
ESTONIA_INCLUDE_SOLE_TRADERS=false
# Switzerland — SHAB HR01 via the Official Gazettes Portal API (SECO): no key. URL override optional.
SWITZERLAND_SHAB_API_URL=
# Include sole proprietorships (natural persons). Default false (privacy).
SWITZERLAND_INCLUDE_SOLE_TRADERS=false
# Poland — KRS open API (no key). Optional override and scan stop rule (consecutive older extracts).
POLAND_KRS_API_URL=
POLAND_KRS_STOP_AFTER=40
# United States — NY / CO / CT open-data portals (no key). An optional free Socrata app token raises rate limits.
US_SOCRATA_APP_TOKEN=
# Canada — Corporations Canada daily federal corporations file (no key). Optional URL override.
CANADA_CBCA_ACTIVE_URL=
# Australia — ASIC company dataset on data.gov.au (no key). Optional override.
AUSTRALIA_DATA_GOV_API=
# Japan — NTA Corporate Number Web-API: free application ID (register at houjin-bangou.nta.go.jp/webapi). Feed stays off until set.
JAPAN_HOUJIN_APP_ID=
JAPAN_HOUJIN_API_URL=
# France — BODACC A "Créations" (DILA open data, Licence Ouverte 2.0): no key. URL override optional.
FRANCE_BODACC_API_URL=
# Include sole traders (personnes physiques). Default false (privacy).
FRANCE_INCLUDE_SOLE_TRADERS=false
# Czechia — ARES public REST API (notification batches of the public register): no key. URL override optional.
CZECHIA_ARES_API_URL=
# Include associations, foundations and other non-profits. Default false (business prospects only).
CZECHIA_INCLUDE_NON_PROFITS=false
# Contact research politeness: minimum gap between requests to the same website host (ms).
FETCH_HOST_GAP_MS=1000
# United Kingdom — Companies House Public Data API (free key):
#   https://developer.company-information.service.gov.uk/
UK_COMPANIES_HOUSE_API_KEY=
# France — INSEE API Sirene 3.11 (free key): https://portail-api.insee.fr/
FRANCE_SIRENE_API_KEY=
FRANCE_SIRENE_API_URL=
# Include sole traders (natural persons) from Sirene. Default false (privacy).
FRANCE_INCLUDE_SOLE_TRADERS=false
# Denmark — CVR system-to-system access (credentials from cvrselvbetjening@erst.dk)
DENMARK_CVR_USERNAME=
DENMARK_CVR_PASSWORD=
DENMARK_CVR_API_URL=
# United Kingdom — separate STREAMING application key (stream.companieshouse.gov.uk)
UK_COMPANIES_HOUSE_STREAMING_API_KEY=
UK_STREAM_WORKER=on
# Netherlands — KVK API subscription (Mutatieservice + Basisprofiel), header "apikey".
# NL_KVK_API_URL defaults to production; KVK's test environment (fictional data) is refused in production.
NL_KVK_API_KEY=
NL_KVK_SUBSCRIPTION_ID=
NL_KVK_API_URL=
# Estonia — RIK e-Business Register XML services (agreement + username/password)
ESTONIA_RIK_USERNAME=
ESTONIA_RIK_PASSWORD=
ESTONIA_RIK_API_URL=
# Germany — OpenRegister (commercial, Bearer key)
OPENREGISTER_API_KEY=
# Ireland — CRO open data (no key). Overrides are optional.
IRELAND_CRO_API_URL=
IRELAND_CRO_RESOURCE_ID=
# Commercial fallback for gaps (enable per country in Settings → Countries)
OPENCORPORATES_API_TOKEN=
# Sweden: SCB Business Register API needs a client certificate from SCB — no adapter yet (see docs).

# ── Contact-data providers (retrieval only — no sending, sequences or campaigns) ──
# Enable each in Settings → Research and set budgets there (budget 0 = paid calls paused).
HUNTER_API_KEY=
APOLLO_API_KEY=
BRAVE_SEARCH_API_KEY=
# A value shared by this many companies is treated as an intermediary
SHARED_CONTACT_THRESHOLD=3

# Sync engine
REGISTRY_MAX_PER_RUN=5000
REGISTRY_PEOPLE_PER_RUN=300
# In-process workers (single instance). Set to "off" on serverless/multi-instance
# deployments and call /api/registry/cron (every 5 min) and /api/jobs/cron (every 30–60 s).
REGISTRY_SCHEDULER=on
WORKER_FAST_TICK_MS=30000
RESEARCH_CONCURRENCY=2
# Live feed polling (seconds) — subject to each source's limits
NORWAY_FEED_POLL_SECONDS=60
NL_FEED_POLL_SECONDS=60
ESTONIA_FEED_POLL_SECONDS=300
# Protects /api/registry/cron (scheduled syncs + follow-up reminders).
CRON_SECRET=


# ── Verified Opportunity Intelligence (OWNER-only module; see docs/opportunities/README.md) ──
# Open sources need no keys: TED, Arbetsförmedlingen JobTech (SE), Find a Tender, Contracts Finder,
# BOAMP, and employer Greenhouse / Lever / Ashby boards and careers pages.
# Feeds run on the existing slow tick; set OPPORTUNITY_SCHEDULER=off to pause them.
OPPORTUNITY_SCHEDULER=on
# Max records processed per feed run (capped runs resume from their cursor on the next tick).
OPPORTUNITY_RUN_LIMIT=1500
# Norway — NAV job vacancy feed: free consumer token on request (nav.team.arbeidsplassen@nav.no).
NAV_JOB_FEED_TOKEN=
NAV_JOB_FEED_URL=
# France — France Travail Offres d'emploi v2: register an application on francetravail.io.
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
# Adzuna (aggregator; UK/DE/FR). Commercial use needs an Adzuna agreement — also enable it in the UI.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Realtime: memory (single instance). Implement a Redis provider to scale out.
REALTIME_PROVIDER=memory

# File uploads (chat attachments, ticket attachments, documents).
UPLOAD_DIR=storage/uploads
