{
  "name": "exploretechify",
  "version": "0.1.0",
  "private": true,
  "description": "ExploreTechify - Digital & Business Operations Partner platform",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed": "tsx --conditions=react-server scripts/seed.ts",
    "seed:reset": "tsx --conditions=react-server scripts/seed.ts --reset",
    "registry:verify": "tsx --conditions=react-server scripts/verify-providers.ts",
    "registry:sync": "tsx --conditions=react-server scripts/registry-sync.ts",
    "migrate": "tsx --conditions=react-server scripts/migrate.ts",
    "db:migrate-to-atlas": "tsx scripts/migrate-to-atlas.ts",
    "coverage:report": "tsx scripts/coverage-report.ts",
    "geoip:update": "node scripts/geoip-update.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "fast-xml-parser": "^5.11.2",
    "imapflow": "^2.8.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.51.0",
    "mailparser": "^3.12.0",
    "maxmind": "5.0.7",
    "mongoose": "^8.24.4",
    "next": "^16.3.8",
    "nodemailer": "^10.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "mongodb-memory-server": "^10.4.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
